{
  "version": "2.0.0",
  "tasks": [
    {
      // Keeps .features-gen/ in sync with your .feature + step files so the
      // Playwright Test extension's debug buttons always run current specs.
      // Auto-starts when you open the folder (allow it when VS Code prompts).
      "label": "bddgen: watch",
      "type": "npm",
      "script": "bddgen:watch",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "bdd"
      },
      "problemMatcher": {
        "owner": "bddgen",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[nodemon\\] starting",
          "endsPattern": "\\[nodemon\\] (clean exit|app crashed)"
        }
      }
    },
    {
      // One-shot regeneration you can run on demand (Terminal > Run Task).
      "label": "bddgen",
      "type": "npm",
      "script": "bddgen",
      "problemMatcher": []
    }
  ]
}
