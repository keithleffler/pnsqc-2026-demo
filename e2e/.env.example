# Copy to .env and adjust for your target. ConfigManager reads ENVIRONMENT,
# BROWSER, and HEADLESS; UrlConstants reads BASE_UI_URL / BASE_API_URL.
ENVIRONMENT=QA
BROWSER=chromium
HEADLESS=true

# Medusa storefront under test. The suite appends the region path (/us, /gb).
# odinforge is the deployed docker stack; use http://localhost:8011 for local.
BASE_UI_URL=http://odinforge:8011
BASE_API_URL=http://odinforge:9001
